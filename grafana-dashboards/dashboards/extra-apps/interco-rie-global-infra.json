          "editorMode": "code",
          "expr": "irate(node_pressure_io_waiting_seconds_total{instance=~\"$node\"}[$__rate_interval])",
          "hide": false,
          "instant": false,
          "legendFormat": "I/O",
          "range": true,
          "refId": "C"
