          "editorMode": "code",
          "expr": "irate(node_pressure_memory_waiting_seconds_total{instance=~\"$node\"}[$__rate_interval])",
          "hide": false,
          "instant": false,
          "legendFormat": "MEM",
          "range": true,
          "refId": "B"
